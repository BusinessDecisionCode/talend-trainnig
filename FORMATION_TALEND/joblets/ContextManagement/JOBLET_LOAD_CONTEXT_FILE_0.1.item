      <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xA;output_row.key = input_row.key;&#xA;output_row.value = input_row.value;&#xA;&#xA;// Password Decryption&#xA;if(output_row.key.toUpperCase().contains(&quot;PASSWORD&quot;))&#xA;&#x9;output_row.value = routines.system.PasswordEncryptUtil.decryptPassword(input_row.value);&#xA;&#xA;&#xA;"/>
